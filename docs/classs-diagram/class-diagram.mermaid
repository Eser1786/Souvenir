classDiagram
    direction TB

    %% =========================================================================
    %% 1. NHÓM TÀI KHOẢN, PHÂN QUYỀN & PHIÊN LÀM VIỆC
    %% =========================================================================
    class NguoiDung {
        +int id
        +string tenDangNhap
        +string matKhau
        +string hoTen
        +string soDienThoai
        +enum vaiTro
        +enum trangThai
        +int soLanDangNhapSai
        +kiemTraDangNhap()
        +khoaTaiKhoan()
    }

    class CaLamViec {
        +int id
        +int nguoiDungId
        +datetime thoiGianMoCa
        +datetime thoiGianChotCa
        +float tienMatBanGiao
        +float tienMatThucTe
        +float doanhThuHeThong
        +string lyDoChenhLech
        +enum trangThai
        +moCa()
        +chotCa()
    }

    class ChamCong {
        +int id
        +int nguoiDungId
        +int caLamViecId
        +datetime gioCheckIn
        +datetime gioCheckOut
        +checkIn()
        +checkOut()
    }

    %% =========================================================================
    %% 2. NHÓM ĐỐI TÁC & HÀNG HÓA KHO
    %% =========================================================================
    class NhaCungCap {
        +int id
        +string maNCC
        +string tenNCC
        +string soDienThoai
        +string diaChi
        +enum trangThai
        +capNhatThongTin()
    }

    class SanPham {
        +int id
        +string maSP
        +string tenSP
        +string donViTinh
        +float giaNhap
        +float giaBan
        +int soLuongTon
        +enum trangThai
        +capNhatTonKho()
        +doiGiaBan()
    }

    class PhieuNhapKho {
        +int id
        +string maPhieu
        +int nhaCungCapId
        +int nguoiDungId
        +float tongTienNhap
        +datetime ngayNhap
        +enum trangThai
        +xacNhanNhapKho()
    }

    class ChiTietNhapKho {
        +int phieuNhapKhoId
        +int sanPhamId
        +int soLuongNhap
        +float donGiaNhap
        +float thanhTien
        +tinhThanhTien()
    }

    class PhieuKiemKe {
        +int id
        +string maPhieu
        +int nguoiDungId
        +datetime ngayKiemKe
        +enum trangThai
        +canBangTonKho()
    }

    class ChiTietKiemKe {
        +int phieuKiemKeId
        +int sanPhamId
        +int soTonSoSach
        +int soTonThucTe
        +int soLuongChenhLech
        +string lyDoChenhLech
        +tinhChenhLech()
    }

    %% =========================================================================
    %% 3. NHÓM BÁN HÀNG, KHÁCH HÀNG & KHUYẾN MÃI
    %% =========================================================================
    class KhachHang {
        +int id
        +string soDienThoai
        +string tenKhachHang
        +int diemTichLuy
        +tichDiem()
        +doiDiem()
    }

    class MaGiamGia {
        +int id
        +string maCode
        +string tenVoucher
        +enum loaiGiamGia
        +float giaTriGiam
        +float giamToiDa
        +float giaTriDonToiThieu
        +datetime ngayBatDau
        +datetime ngayKetThuc
        +enum trangThai
        +kiemTraDieuKien()
    }

    class DonHang {
        +int id
        +int caLamViecId
        +int khachHangId
        +int nguoiDungId
        +int maGiamGiaId
        +datetime ngayTao
        +datetime ngayThanhToan
        +float tongTienTuongDoi
        +float tienGiamGia
        +float tongTienThanhToan
        +enum hinhThucThanhToan
        +float tienKhachDua
        +float tienThua
        +enum trangThai
        +tinhTongTien()
        +xacNhanThanhToan()
    }

    class ChiTietDonHang {
        +int donHangId
        +int sanPhamId
        +int soLuong
        +float donGia
        +float thanhTien
        +kiemTraTonKho()
    }

    class PhieuTraHang {
        +int id
        +string maPhieu
        +int donHangGocId
        +int nguoiDungId
        +float tongTienHoan
        +datetime ngayTra
        +enum trangThai
        +xacNhanHoanTien()
    }

    class ChiTietTraHang {
        +int phieuTraHangId
        +int sanPhamId
        +int soLuongTra
        +float donGiaHoan
        +string tinhTrangHang
        +congLaiTonKho()
    }

    %% =========================================================================
    %% QUAN HỆ GIỮA CÁC LỚP ĐỐI TƯỢNG (RELATIONSHIPS)
    %% =========================================================================

    %% Người dùng với các nghiệp vụ
    NhaCungCap "1" -- "*" PhieuNhapKho : Cung cap
    NguoiDung "1" -- "*" PhieuNhapKho : Lap phieu nhap
    NguoiDung "1" -- "*" PhieuKiemKe : Lap phieu kiem
    NguoiDung "1" -- "*" CaLamViec : Quan ly ca
    NguoiDung "1" -- "*" ChamCong : Thuc hien
    NguoiDung "1" -- "*" DonHang : Tao don
    NguoiDung "1" -- "*" PhieuTraHang : Xu ly tra hang

    %% Nhập kho
    PhieuNhapKho "1" -- "*" ChiTietNhapKho : Chua chi tiet
    SanPham "1" -- "*" ChiTietNhapKho : Nhap vao

    %% Kiểm kê kho
    PhieuKiemKe "1" -- "*" ChiTietKiemKe : Chua chi tiet
    SanPham "1" -- "*" ChiTietKiemKe : Duoc kiem dem

    %% Bán hàng & Thanh toán
    KhachHang "1" -- "*" DonHang : Mua hang
    MaGiamGia "1" -- "*" DonHang : Ap dung
    CaLamViec "1" -- "*" DonHang : Quan ly don
    CaLamViec "1" -- "1" ChamCong : Ghi nhan tgian
    DonHang "1" *-- "*" ChiTietDonHang : Bao gom
    SanPham "1" -- "*" ChiTietDonHang : Co trong don

    %% Đổi trả hàng
    DonHang "1" -- "*" PhieuTraHang : Hoan tra tu
    PhieuTraHang "1" -- "*" ChiTietTraHang : Chua chi tiet
    SanPham "1" -- "*" ChiTietTraHang : Bi hoan tra
